# Copy this file to .env. Never add the resulting .env file to a build or commit.

# Local web server
FLASK_SECRET_KEY=replace-with-a-random-value
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
SESSION_COOKIE_SECURE=0
ENABLE_DEBUG_ENDPOINTS=0

# Remote access is disabled by default. If enabled, use HTTPS through a trusted
# reverse proxy, restrict direct access to the backend, and send APP_API_TOKEN
# as a bearer token on every request. Trust X-Forwarded-Proto only from that proxy.
ALLOW_REMOTE_ACCESS=0
APP_API_TOKEN=
TRUST_PROXY_HEADERS=0

# Reddit (optional)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=FeedbackCollector/1.0
REDDIT_SUBREDDITS=SQLServer

# GitHub (optional for Issues; required for Discussions and higher rate limits)
GITHUB_TOKEN=
GITHUB_REPO_OWNER=microsoft
GITHUB_REPO_NAME=vscode-mssql

# Azure DevOps work items (optional)
ADO_PAT=
ADO_ORG_URL=https://dev.azure.com/your-organization
ADO_PROJECT_NAME=
ADO_PARENT_WORK_ITEM_ID=

# Microsoft Fabric SQL (optional)
# Enter the short-lived Fabric bearer token in the application. Tokens are
# retained only in the server process for the configured lifetime.
FABRIC_SQL_SERVER=
FABRIC_SQL_DATABASE=
FABRIC_TOKEN_TTL_SECONDS=28800

# Power BI report embedding (optional)
POWERBI_REPORT_ID=
POWERBI_TENANT_ID=
POWERBI_EMBED_BASE_URL=https://app.fabric.microsoft.com/reportEmbed

# Collection and HTTP limits
MAX_ITEMS_PER_RUN=500
REQUEST_TIMEOUT_SECONDS=30
HTTP_RETRY_COUNT=3
HTTP_BACKOFF_FACTOR=0.5
DEFAULT_STATUS=New
SYSTEM_USER=FeedbackCollector
